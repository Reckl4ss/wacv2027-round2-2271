\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Cross-space portability matrix.} Spearman $\operatorname  {corr}(Q,\mathrm  {acc})$ for $13$ standard proxies over $7$ search spaces, with rows ordered most-to-least stable (flip count ascending, then mean $|\rho |$). Heavy boxes and $\star $ mark negative cells in the four CI-separated cases (\textsf  {jacob-cov}, \textsf  {grasp}, \textsf  {zen}, \textsf  {plain}); the side panel reports each proxy's flip count and stability tier ($\text  {$\mathsurround \z@ \mathchar "458$}$: no reversal; $\sim $: descriptive reversal; $\mathsf  {X}$: CI-separated reversal). Nine of $13$ proxies reverse descriptively on at least one space, while four meet the strict rule. Per-space sample sizes and intervals are in \cref  {tab:app-portability} and \cref  {app:generalize-evidence}.\relax }}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:portability}{{3}{7}{\textbf {Cross-space portability matrix.} Spearman $\corr (Q,\acc )$ for $13$ standard proxies over $7$ search spaces, with rows ordered most-to-least stable (flip count ascending, then mean $|\rho |$). Heavy boxes and $\star $ mark negative cells in the four CI-separated cases (\px {jacob-cov}, \px {grasp}, \px {zen}, \px {plain}); the side panel reports each proxy's flip count and stability tier ($\checkmark $: no reversal; $\sim $: descriptive reversal; $\mathsf {X}$: CI-separated reversal). Nine of $13$ proxies reverse descriptively on at least one space, while four meet the strict rule. Per-space sample sizes and intervals are in \cref {tab:app-portability} and \cref {app:generalize-evidence}.\relax }{figure.caption.4}{}}
